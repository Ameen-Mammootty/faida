# Server-side URL used by the same-origin waitlist proxy.
# This value is never exposed to the browser.
FAIDA_API_URL=http://127.0.0.1:8000

# Invoice review screen (C6 client). All three are NEXT_PUBLIC_*: inlined into
# the JS bundle at build time, so changing them requires a rebuild/redeploy.
# Unset, the review screen runs in mock mode (mock unless the exact string "false").
NEXT_PUBLIC_MOCK_API=false
NEXT_PUBLIC_API_BASE=http://localhost:8000   # the FastAPI service, no trailing slash
NEXT_PUBLIC_API_TOKEN=changeme               # demo bearer token (API_TOKEN on the API side); real auth is M6
