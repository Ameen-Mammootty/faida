# Server-side URL used by the same-origin waitlist proxy.
# This value is never exposed to the browser.
FAIDA_API_URL=http://127.0.0.1:8000

# Console screens (C6 client + M7 login). All NEXT_PUBLIC_*: inlined into the
# JS bundle at build time, so changing one requires a rebuild/redeploy.
# Unset, the console runs in mock mode (mock unless the exact string "false"):
# sample data, no login, no Supabase.
NEXT_PUBLIC_MOCK_API=false
NEXT_PUBLIC_API_BASE=http://localhost:8000   # the FastAPI service, no trailing slash

# Login (M7 WP-71). The browser signs in with Supabase Auth and sends the
# user's access token to the API on every call. Both values are public by
# design: the project URL, and the anon (publishable) key, which grants
# nothing on its own.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co   # Supabase dashboard: Project settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>      # same page; the anon / publishable key, never the service role
