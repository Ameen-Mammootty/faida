# Copy to apps/api/.env for local dev, or set in the host's environment.

# Supabase -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/faida

# Meta developer app (WhatsApp product)
META_VERIFY_TOKEN=pick-any-string-and-use-it-in-the-meta-console
META_APP_SECRET=            # App settings -> Basic -> App secret
META_ACCESS_TOKEN=          # WhatsApp -> API setup -> temporary (24h) or system-user token
META_PHONE_NUMBER_ID=       # WhatsApp -> API setup -> Phone number ID
# GRAPH_API_BASE=           # defaults to the newest live version; override only to pin

# Extraction (M1+). Gemini 3 Flash is the shipped default (2026-08-29 Decision Log);
# without the selected provider's key a forwarded photo is acked, then fails after
# 3 retries and the sender gets the failure reply.
GEMINI_API_KEY=             # aistudio.google.com -> API keys (billing enabled; the
                            # free tier serves Gemini 3 models at zero requests)
# EXTRACTION_PROVIDER=anthropic   # instant swap back to Claude Opus 5, no deploy
ANTHROPIC_API_KEY=          # console.anthropic.com -> API keys (billing enabled)

# Supabase Storage (Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=       # service_role key - backend only, never in the browser
STORAGE_BUCKET=documents

WORKER_ENABLED=true

# Review screen API (C6, M7). The web app sends the signed-in user's Supabase
# access token as the bearer; the API verifies it against the project's public
# signing keys at $SUPABASE_URL/auth/v1/.well-known/jwks.json, so there is no
# API secret to set here. The project must be on JWT signing keys (dashboard:
# Authentication -> JWT keys), and the legacy JWT secret stays: it signs the
# service_role key above.
WEB_ORIGIN=http://localhost:3000  # the apps/web origin allowed through CORS
